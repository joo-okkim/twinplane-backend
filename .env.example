PORT=4000
DATABASE_URL=postgresql://twinplane:changeme@localhost:5432/twinplane
JWT_SECRET=change-me-to-a-random-secret
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude

# Social login (POST /api/auth/oauth/*, see src/routes/auth.js).
# Kakao needs no server-side key here -- kapi.kakao.com validates the
# client-issued access token itself; only the Flutter app needs a Kakao
# native app key (set on the client, not here).
# GOOGLE_CLIENT_ID is the OAuth "Web" client ID from Google Cloud Console
# (a public audience value, not a secret) -- required to verify Google ID
# tokens. Leaving it unset makes /api/auth/oauth/google fail loudly (501)
# instead of accepting unverifiable tokens.
GOOGLE_CLIENT_ID=
